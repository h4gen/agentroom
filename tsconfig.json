{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/web/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "apps/web/**/*.tsx"
  ]
}
