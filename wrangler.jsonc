{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentroom-v0",
  "main": "apps/relay/src/index.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "71001",
      "simple": { "limit": 6, "period": 60 },
    },
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "71002",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 50 },
}
